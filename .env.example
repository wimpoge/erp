# Copy to .env in erp/ or pos/ (or export) to override defaults.
ERP_DATABASE_URL=sqlite:///./erp.db
ERP_FAIL_RATE=0
POS_DATABASE_URL=sqlite:///./pos.db
POS_ERP_BASE_URL=http://localhost:8001
# Behind HTTPS: send the session cookie only over TLS.
POS_COOKIE_SECURE=false
# web/: where the Next.js server forwards /api/* to.
POS_API_URL=http://localhost:8000

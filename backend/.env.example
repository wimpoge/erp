# Local development defaults to SQLite (./erp.db); nothing to set.
# Production (Vercel + Neon):
ERP_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
ERP_SERVERLESS=true        # no connection pool per function instance; Neon's pooler does it
ERP_COOKIE_SECURE=true     # session cookie only over HTTPS
